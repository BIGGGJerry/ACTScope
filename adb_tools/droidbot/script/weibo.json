{
    "views": {
        "welcome_layer": {
            "text":"用户协议和隐私条款",
            "class": ".*TextView"
        },
        "welcome_button":{
            "text": "同意并继续",
            "class": ".*TextView"
        },
        "ad":{
            "text":"跳过",
            "class":".*TextView"
        },
        "me_button":{
            "content_desc":"我",
            "class":".*FrameLayout"
        },
        "main_head":{
            "resource_id":".*ll_title_2",
            "class":".*RelativeLayout"
        }

    },
    "states": {
        "welcome_state": {
            "views": ["welcome_layer", "welcome_button"]
        },
        "ad_state":{
            "views": ["ad"]
        },
        "main_state":{
            "views": ["me_button"]
        }
    },
    "operations": {
        "welcome_operation": [
            {
                "event_type": "touch",
                "target_view": "welcome_button"
            },
            {
                "event_type":"exit"
            }
        ],
        "ad_operation":[
            {
                "event_type":"touch",
                "target_view":"ad"
            }
        ],
        "main_operation":[
            {
                "event_type":"touch",
                "target_view":"me_button"
            },
            {
                "event_type":"exit"
            }
        ]

    },
    "main": {
        "main_state":["main_operation"],
        "welcome_state": ["welcome_operation"]
    }
}
