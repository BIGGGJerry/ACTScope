{
    "views": {
        "welcome_layer": {
            "text":"个人信息保护提示",
            "class": ".*TextView"
        },
        "welcome_button":{
            "text": "同意",
            "class": ".*Button"
        },
        "me_button":{
            "content_desc":"我",
            "class":".*ViewGroup"
        }

    },
    "states": {
        "welcome_state": {
            "views": ["welcome_layer", "welcome_button"]
        },
        "main_state":{
            "views": ["me_button"]
        }
    },
    "operations": {
        "welcome_operation": [
            {
                "event_type": "touch",
                "target_view": "welcome_button"
            },
            {
                "event_type":"exit"
            }
        ],
        "main_operation":[
            {
                "event_type":"touch",
                "target_view":"me_button"
            },
            {
                "event_type":"exit"
            }
        ]

    },
    "main": {
        "main_state":["main_operation"],
        "welcome_state": ["welcome_operation"]
    }
}
